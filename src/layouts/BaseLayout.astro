---
import '../styles/global.css';
import '../styles/tokens.css';

// Direct paths for preloading FOUC critical fonts
import inter400Url from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700Url from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';

// Design-system fonts (variable, latin subset). Files carry the opsz axis for
// Fraunces so font-optical-sizing: auto renders the high-contrast display cut.
import frauncesNormalUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import publicSansUrl from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
  ogType?: string;
  keywords?: string;
  ogImage?: string;
  /** Opt migrated pages into the new design-system token values (body.ds-theme). */
  ds?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  schema,
  ogType = 'website',
  keywords = '',
  ogImage = 'https://adacomplianceservices.tech/og-image.png',
  ds = false,
} = Astro.props;

const schemaString = schema ? JSON.stringify(Array.isArray(schema) ? schema : [schema]) : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- 1. Critical preloads stream immediately (per page type) -->
  {!ds && (
    <>
      <link rel="preload" href={inter400Url} as="font" type="font/woff2" crossorigin="anonymous" />
      <link rel="preload" href={inter700Url} as="font" type="font/woff2" crossorigin="anonymous" />
    </>
  )}
  {ds && (
    <>
      <link rel="preload" href={frauncesNormalUrl} as="font" type="font/woff2" crossorigin="anonymous" />
      <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin="anonymous" />
      <link rel="preload" href={publicSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    </>
  )}

  <style define:vars={{ inter400Url, inter700Url, frauncesNormalUrl, frauncesItalicUrl, publicSansUrl }}>
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400;
      font-display: optional;
      src: url(var(--inter400Url)) format('woff2');
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 700;
      font-display: optional;
      src: url(var(--inter700Url)) format('woff2');
    }
    /* Design-system faces. Variable weight ranges cover 400–700 usage;
       Fraunces keeps the opsz axis so optical sizing works. */
    @font-face {
      font-family: 'Fraunces';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url(var(--frauncesNormalUrl)) format('woff2-variations');
    }
    @font-face {
      font-family: 'Fraunces';
      font-style: italic;
      font-weight: 100 900;
      font-display: swap;
      src: url(var(--frauncesItalicUrl)) format('woff2-variations');
    }
    @font-face {
      font-family: 'Public Sans';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url(var(--publicSansUrl)) format('woff2-variations');
    }
  </style>

  <!-- 2. Document encoding and rendering rules -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content={ds ? '#1c3a2a' : '#1a3a2a'} />
  
  <!-- 3. Meta metadata -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="complyTech — ADA Compliance Services" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="complyTech" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:site" content="@complyTechADA" />



  <!-- Schema JSON-LD -->
  {schemaString && <script type="application/ld+json" set:html={schemaString} />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>
<body class:list={[{ 'ds-theme': ds }]}>
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <slot name="nav" />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    z-index: -1;
  }
  .skip-link:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    overflow: visible;
    z-index: 9999;
    background: var(--accent, #1a3a2a);
    color: #fff;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }

  /* ── Design-system page base (migrated pages only, via the ds prop) ── */
  body.ds-theme {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-body);
    font-family: var(--font-body);
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Global link rules from the mockup's helmet block */
  body.ds-theme a { color: var(--color-accent); text-decoration: none; }
  body.ds-theme a:hover { color: var(--color-accent-hover); }

  /* Underlined link utility for dark panels */
  body.ds-theme .u-link {
    color: var(--color-on-dark-mint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  body.ds-theme .u-link:hover { color: var(--color-on-dark); }

  /* Content container for section shells */
  body.ds-theme .ds-container {
    width: 100%;
    max-width: var(--layout-max);
    margin-inline: auto;
  }

  /* Focus visibility (SC 2.4.11/2.4.13) — the mockup defines none */
  body.ds-theme :where(a, button, summary, input, select, textarea, [tabindex]):focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
  /* Light ring variant so focus stays visible on dark panels */
  body.ds-theme .on-dark :where(a, button, summary, input, select, textarea, [tabindex]):focus-visible {
    outline-color: var(--focus-ring-dark);
  }

  body.ds-theme .skip-link:focus {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  /* Keep motion minimal; honour user preference */
  @media (prefers-reduced-motion: reduce) {
    body.ds-theme *,
    body.ds-theme *::before,
    body.ds-theme *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
  }
</style>

