---
// Single inline-icon component (Lucide-style stroke paths, hand-copied from
// design/Main.dc.html). No runtime icon library. Filled glyphs (star,
// whatsapp) set fill:currentColor and no stroke; everything else is stroke.
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
  /** Provide only when the icon conveys meaning a sighted user needs. */
  label?: string;
}

const { name, size = 24, strokeWidth = 2, class: className, label } = Astro.props;

type Glyph = { d: string[]; circles?: { cx: number; cy: number; r: number }[]; filled?: boolean };

const glyphs: Record<string, Glyph> = {
  'shield-check': {
    d: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', 'm9 12 2 2 4-4'],
  },
  shield: {
    d: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'],
  },
  'arrow-right': {
    d: ['M5 12h14', 'm12 5 7 7-7 7'],
  },
  check: {
    d: ['M20 6 9 17l-5-5'],
  },
  search: {
    d: ['m21 21-4.3-4.3'],
    circles: [{ cx: 11, cy: 11, r: 8 }],
  },
  hospital: {
    d: [
      'M12 6v4',
      'M14 8h-4',
      'M18 21V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16',
      'M18 11h2a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2h2',
      'M10 21v-3a2 2 0 0 1 4 0v3',
    ],
  },
  book: {
    d: [
      'M4 19.5A2.5 2.5 0 0 1 6.5 17H20',
      'M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
    ],
  },
  'alert-triangle': {
    d: [
      'M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z',
      'M12 9v4',
      'M12 17h.01',
    ],
  },
  info: {
    d: ['M12 16v-4', 'M12 8h.01'],
    circles: [{ cx: 12, cy: 12, r: 10 }],
  },
  'chevron-down': {
    d: ['m6 9 6 6 6-6'],
  },
  star: {
    d: ['m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'],
    filled: true,
  },
  whatsapp: {
    d: [
      'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884',
    ],
    filled: true,
  },
};

const glyph = glyphs[name];
if (!glyph) throw new Error(`Icon.astro: unknown icon "${name}"`);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={glyph.filled ? 'currentColor' : 'none'}
  stroke={glyph.filled ? 'none' : 'currentColor'}
  stroke-width={glyph.filled ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
>
  {glyph.circles?.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
  {glyph.d.map((d) => <path d={d} />)}
</svg>
