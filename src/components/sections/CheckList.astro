---
// Checklist with 20px check icons. Items accept trusted HTML (from our own
// content modules) so parts of a line can be bolded.
import Icon from '../ui/Icon.astro';

interface Props {
  items: string[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ul class:list={['ds-checklist', className]}>
  {
    items.map((item) => (
      <li>
        <Icon name="check" size={20} strokeWidth={2.4} />
        <span set:html={item} />
      </li>
    ))
  }
</ul>

<style>
  .ds-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ds-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--type-body-list);
    color: var(--color-body);
  }
  .ds-checklist li :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--color-accent-ink);
  }
</style>
