---
// FAQ section: intro column + native <details>/<summary> accordion, with
// optional FAQPage JSON-LD generated from the same data (so copy and
// structured data cannot drift).
import Eyebrow from '../ui/Eyebrow.astro';
import FaqAccordion from '../ui/FaqAccordion.astro';

interface Faq {
  q: string;
  a: string;
}

interface Props {
  id: string;
  eyebrow?: string;
  heading: string;
  /** Plain intro text under the heading; use the `deck` slot to include links */
  deck?: string;
  faqs: Faq[];
  firstOpen?: boolean;
  /** Emit FAQPage JSON-LD from the same data (disable if the page already emits one) */
  emitJsonLd?: boolean;
}

const { id, eyebrow = 'FAQ', heading, deck, faqs, firstOpen = true, emitJsonLd = true } = Astro.props;
const headingId = `${id}-h`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="faq" id={id} aria-labelledby={headingId}>
  <div class="faq-grid">
    <div class="faq-intro">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="faq-h" id={headingId}>{heading}</h2>
      {deck && <p class="faq-deck">{deck}</p>}
      <slot name="deck" />
    </div>

    <FaqAccordion items={faqs.map((f) => ({ question: f.q, answer: f.a }))} firstOpen={firstOpen} />
  </div>
</section>

{emitJsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<style>
  .faq {
    padding: 0 var(--gutter) var(--section-y);
  }
  .faq-grid {
    max-width: var(--layout-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
    align-items: start;
  }

  .faq-h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.625rem, 1.25rem + 1.5vw, var(--type-h2-sm));
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 12px 0 0;
  }
  .faq-deck {
    font-size: var(--type-body-list);
    line-height: 1.6;
    color: var(--color-muted-2);
    margin: 18px 0 0;
  }

  @media (max-width: 900px) {
    .faq-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
