---
// Dark CTA panel: centered heading, deck, action buttons (passed as the
// `actions` slot so pages control their own conversion links).
interface Props {
  id: string;
  heading: string;
  deck?: string;
}

const { id, heading, deck } = Astro.props;
---

<section class="cta" id={id} aria-labelledby={`${id}-h`}>
  <div class="cta-panel on-dark">
    <h2 class="cta-h" id={`${id}-h`}>{heading}</h2>
    {deck && <p class="cta-deck">{deck}</p>}
    <div class="cta-actions">
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 0 var(--gutter) var(--section-y);
  }
  .cta-panel {
    max-width: var(--layout-max);
    margin-inline: auto;
    background: var(--color-accent-deep);
    border-radius: var(--radius-panel);
    padding: clamp(2rem, 1rem + 3.2vw, 4rem);
    text-align: center;
  }
  .cta-h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.875rem, 1.5rem + 1.56vw, var(--type-h2-cta));
    letter-spacing: -0.02em;
    color: var(--color-on-dark);
    line-height: 1.15;
    max-width: 720px;
    margin: 0 auto;
  }
  .cta-deck {
    font-size: var(--type-lead-cta);
    color: var(--color-on-dark-sage);
    margin: 20px auto 0;
    max-width: 560px;
    line-height: 1.6;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }
  @media (max-width: 480px) {
    .cta-actions :global(.ds-btn) { width: 100%; }
  }
</style>
