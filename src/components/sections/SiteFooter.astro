---
// Site footer — mockup's 4-column grid extended (approved) with the real
// contact plumbing: contact/Fiverr column, WhatsApp button and floating
// WhatsApp affordance. Link columns sit in named <nav> landmarks.
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

const WA_LINK = `https://wa.me/923010910933?text=${encodeURIComponent('Hi, I need an ADA compliance audit for my website.')}`;

const year = new Date().getFullYear();

const columns = [
  {
    label: 'Services',
    links: [
      { href: '/ada-compliance-audit-small-business', label: 'Small business audit' },
      { href: '/ada-compliance-healthcare-websites', label: 'Healthcare compliance' },
      { href: '/vpat-documentation-services', label: 'VPAT documentation' },
      { href: '/section-508-compliance', label: 'Section 508' },
    ],
  },
  {
    label: 'Resources',
    links: [
      { href: '/ada-compliance-faq', label: 'ADA FAQ' },
      { href: '/ada-compliance-checklist-2026', label: 'Compliance checklist' },
      { href: '/wcag-2-1-vs-wcag-2-2', label: 'WCAG 2.1 vs 2.2' },
      { href: '/free-ada-website-scan', label: 'Free website scan' },
    ],
  },
  {
    label: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/testimonials', label: 'Testimonials' },
      { href: '/privacy-policy', label: 'Privacy policy' },
      { href: WA_LINK, label: 'Contact', external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="complyTech — home">
          <span class="footer-mark" aria-hidden="true">
            <Icon name="shield-check" size={19} strokeWidth={2} />
          </span>
          <span class="footer-wordmark">comply<span class="footer-accent">Tech</span></span>
        </a>
        <p class="footer-blurb">
          ADA compliance audits and WCAG&nbsp;2.2 remediation for U.S. businesses. IAAP-certified specialists.
        </p>
        <Button href={WA_LINK} variant="primary" size="sm" class="footer-cta" target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={16} slot="leading" />
          Chat on WhatsApp
        </Button>
      </div>

      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.label}>
            <h2 class="footer-heading">{col.label}</h2>
            <ul class="footer-links">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col">
        <h2 class="footer-heading">Contact</h2>
        <ul class="footer-links">
          <li><a href="mailto:ahtisham0100@gmail.com">ahtisham0100@gmail.com</a></li>
          <li><a href={WA_LINK} target="_blank" rel="noopener noreferrer">+92 301 091 0933 (WhatsApp)</a></li>
          <li><a href="https://fiverr.com/ayti_shami" target="_blank" rel="noopener noreferrer">Fiverr profile</a></li>
          <li><a href="https://www.fiverr.com/s/EgwdYAe" target="_blank" rel="noopener noreferrer">ADA compliance gig</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} complyTech. All rights reserved.</span>
      <span>WCAG&nbsp;2.2 · Section&nbsp;508 · Section&nbsp;1557</span>
    </div>
  </div>

  <a
    href={WA_LINK}
    class="whatsapp-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with complyTech on WhatsApp"
>
    <Icon name="whatsapp" size={28} />
  </a>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-footer);
    padding: 56px var(--gutter) 44px;
  }
  .footer-inner {
    max-width: var(--layout-max);
    margin-inline: auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr;
    gap: 40px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .footer-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 9px; /* mockup footer mark; 1px under the nav mark's --radius-logo */
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    color: var(--color-ink);
  }
  .footer-accent { color: var(--color-accent); }

  .footer-blurb {
    font-size: var(--type-sm);
    line-height: 1.6;
    color: var(--color-muted-2);
    margin: 16px 0 0;
    max-width: 280px;
  }
  .footer-cta { margin-top: 18px; }

  .footer-heading {
    margin: 0;
    font-size: var(--type-label);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .footer-links {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-links a {
    font-size: var(--type-sm);
    font-weight: 400;
    color: var(--color-muted);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--type-xs);
    color: var(--color-muted-2);
  }

  .whatsapp-float {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-card-float);
    z-index: 999;
  }
  .whatsapp-float:hover { background: var(--color-accent-hover); color: var(--color-bg); }

  @media (max-width: 1100px) {
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; }
  }
  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .whatsapp-float { bottom: 20px; right: 20px; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
