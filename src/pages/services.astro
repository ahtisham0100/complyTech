---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import CtaPanel from '../components/sections/CtaPanel.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { WA_LINK } from '../data/home';

const DOMAIN = 'https://adacomplianceservices.tech';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ADA Compliance Services",
    "provider": { "@type": "Organization", "name": "complyTech", "url": DOMAIN },
    "description": "Professional WCAG 2.2 Level AA accessibility audit services for websites, including manual expert audits, VPAT documentation, PDF remediation, and accessibility statements.",
    "areaServed": "United States",
    "serviceType": "Website Accessibility Audit"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": DOMAIN },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": `${DOMAIN}/services` }
    ]
  }
];

const services = [
  {
    icon: 'clipboard-check',
    title: 'ADA Compliance Audit',
    desc: 'Full WCAG\u00a02.2 Level AA manual expert review of your entire website. Includes VPAT, prioritized remediation roadmap, developer-ready fix guide, and compliance certificate after re-test.',
    href: '/ada-compliance-audit-small-business',
    price: 'From $495',
  },
  {
    icon: 'file-text',
    title: 'VPAT Documentation',
    desc: 'IAAP-certified VPAT/ACR documents for federal procurement, enterprise B2B sales, and government contracting. Section\u00a0508 and WCAG\u00a02.2 conformance reporting.',
    href: '/vpat-documentation-services',
    price: 'From $1,500',
  },
  {
    icon: 'award',
    title: 'PDF Accessibility Remediation',
    desc: 'Full PDF remediation including tagging, reading order, alt text, table structure, and color contrast. Individual documents or bulk remediation packages.',
    href: '/how-to-make-pdf-ada-compliant',
    price: 'From $50/doc',
  },
  {
    icon: 'file-check',
    title: 'Accessibility Statement',
    desc: 'Professional accessibility statement template and customization for your website — demonstrating your commitment to inclusive design and ADA compliance.',
    href: '/accessibility-statement-template',
    price: 'Included',
  },
  {
    icon: 'search',
    title: 'Section 508 Compliance',
    desc: 'Specialized audits and VPAT documentation for federal contractors, agencies, and grant recipients. Full Section\u00a0508 conformance reporting.',
    href: '/section-508-compliance',
    price: 'From $1,500',
  },
];

const related = [
  {
    href: '/ada-compliance-audit-pricing',
    title: 'Pricing & Tax Credit',
    desc: 'Transparent audit pricing starting at $495. Learn about the IRS Disabled Access Credit that can return up to $5,000.',
  },
  {
    href: '/ada-compliance-checklist-2026',
    title: 'ADA Compliance Checklist 2026',
    desc: 'Free downloadable WCAG\u00a02.2 Level AA checklist covering all 86 success criteria organized by priority.',
  },
  {
    href: '/what-is-ada-compliance-websites',
    title: 'What Is ADA Compliance?',
    desc: 'Complete guide to ADA website compliance — what it means, who must comply, and what happens if you don\u2019t.',
  },
  {
    href: '/received-ada-demand-letter',
    title: 'Got a Demand Letter?',
    desc: 'Step-by-step guide for small business owners who have received an ADA website demand letter.',
  },
];
---

<BaseLayout
  ds
  title="ADA Compliance Services — Audits, VPAT, PDF Remediation | complyTech"
  description="Professional ADA compliance services: WCAG 2.2 audits, VPAT documentation, PDF remediation, accessibility statements, and Section 508 compliance. Pricing starts at $495."
  canonical={`${DOMAIN}/services`}
  schema={schema}
  keywords="ADA compliance services, WCAG 2.2 audit services, VPAT documentation, PDF accessibility remediation, Section 508 compliance services"
>
  <SiteHeader slot="nav" />

  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep" aria-hidden="true">›</span>
        <span class="current">Services</span>
      </nav>
      <h1 id="page-h1">ADA Compliance Services</h1>
      <p class="hero-sub">Professional WCAG&nbsp;2.2 Level AA accessibility services for U.S. small businesses — from full website audits to VPAT documentation and PDF remediation. Every service is delivered by IAAP-certified accessibility professionals.</p>
      <div class="hero-actions">
        <Button href={WA_LINK} variant="on-dark-solid" target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} slot="leading" />
          Get Free Quote
        </Button>
        <Button href="/ada-compliance-audit-pricing" variant="on-dark-outline">See Pricing</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-hub-grid">
        {services.map((s) => (
          <a href={s.href} class="service-hub-card">
            <div class="shc-icon" aria-hidden="true">
              <Icon name={s.icon} size={28} strokeWidth={2} />
            </div>
            <div class="shc-content">
              <h2>{s.title}</h2>
              <p>{s.desc}</p>
              <div class="shc-footer">
                <span class="shc-price">{s.price}</span>
                <span class="shc-link">Learn more <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="related-section">
        <h2>Related Resources</h2>
        <div class="related-links-grid">
          {related.map((r) => (
            <a href={r.href} class="related-link-card">
              <h3>{r.title}</h3>
              <p>{r.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaPanel id="cta" heading="Ready to Get Started?" deck="Send us your website URL on WhatsApp and receive a detailed scope, timeline, and exact pricing within 1 business day. No obligation.">
    <Button href={WA_LINK} variant="on-dark-solid" target="_blank" rel="noopener noreferrer" slot="actions">
      <Icon name="whatsapp" size={18} slot="leading" />
      Get free quote on WhatsApp
    </Button>
    <Button href="/ada-compliance-audit-pricing" variant="on-dark-outline" slot="actions">
      See pricing
    </Button>
  </CtaPanel>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .services-hub-grid { display: flex; flex-direction: column; gap: 20px; }
  .service-hub-card {
    display: flex; gap: 24px; align-items: flex-start;
    background: var(--color-surface); border: 1px solid var(--border-card); border-radius: var(--radius-lg);
    padding: 32px; text-decoration: none; transition: box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .service-hub-card:hover { box-shadow: var(--shadow-card-soft); border-color: var(--border-button); }
  .shc-icon {
    width: 56px; height: 56px; border-radius: var(--radius-tile); background: var(--color-surface-mint);
    display: flex; align-items: center; justify-content: center; color: var(--color-accent-ink); flex-shrink: 0;
  }
  .shc-content { flex: 1; }
  .shc-content h2 { font-size: var(--type-h3); color: var(--color-ink); margin-bottom: 8px; }
  .shc-content p { font-size: var(--type-card); color: var(--color-muted); line-height: 1.65; margin: 0 0 14px; }
  .shc-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .shc-price { font-weight: 700; color: var(--color-accent-ink); font-size: var(--type-body-sm); }
  .shc-link { font-size: var(--type-sm); font-weight: 600; color: var(--color-accent-ink); display: flex; align-items: center; gap: 4px; }
  .shc-link :global(svg) { transition: transform 0.2s var(--ease); }
  .service-hub-card:hover .shc-link :global(svg) { transform: translateX(3px); }

  .related-section { margin-top: 64px; padding-top: 48px; border-top: 1px solid var(--border-subtle); }
  .related-section h2 { text-align: center; margin-bottom: 32px; }
  .related-links-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .related-link-card {
    background: var(--color-bg); border: 1px solid var(--border-card); border-radius: var(--radius-md);
    padding: 24px; text-decoration: none; transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .related-link-card:hover { box-shadow: var(--shadow-card-soft); border-color: var(--border-button); }
  .related-link-card h3 { font-size: var(--type-body); color: var(--color-ink); margin-bottom: 8px; }
  .related-link-card p { font-size: var(--type-card); color: var(--color-muted); margin: 0; line-height: 1.6; }

  @media (max-width: 700px) {
    .service-hub-card { flex-direction: column; gap: 16px; }
    .related-links-grid { grid-template-columns: 1fr; }
  }
</style>
