---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import AuditReportCard from '../components/sections/AuditReportCard.astro';
import StatPanel from '../components/sections/StatPanel.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import ServiceCard from '../components/sections/ServiceCard.astro';
import WhyCoverage from '../components/sections/WhyCoverage.astro';
import CoverageCard from '../components/sections/CoverageCard.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import Faq from '../components/sections/Faq.astro';
import CtaPanel from '../components/sections/CtaPanel.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { hero, auditCard, stats, services, why, coverage, process, faq, cta, WA_LINK } from '../data/home';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'complyTech',
    url: 'https://adacomplianceservices.tech',
    telephone: '+923010910933',
    description:
      'ADA compliance services agency specializing in WCAG 2.2 website accessibility audits, remediation, and certification for businesses across the United States.',
    serviceArea: 'United States',
    knowsAbout: ['ADA Compliance', 'WCAG 2.2', 'Web Accessibility', 'Section 508', 'Section 1557', 'Accessibility Auditing', 'VPAT'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'complyTech',
    url: 'https://adacomplianceservices.tech',
  },
];
---

<BaseLayout
  ds
  title="complyTech — ADA Compliance Audit Services | WCAG 2.2"
  description="Professional ADA compliance audit services by IAAP-certified experts. Manual WCAG 2.2 audits catch 60–70% of violations automated tools miss. Get a free quote via WhatsApp."
  canonical="https://adacomplianceservices.tech"
  schema={schema}
>
  <SiteHeader slot="nav" />

  <Hero id="hero-h" pill={hero.pill} line1={hero.line1} line2={hero.line2} lead={hero.lead} trust={hero.trust}>
    <Button href={WA_LINK} variant="primary" target="_blank" rel="noopener noreferrer" slot="actions">
      <Icon name="whatsapp" size={18} slot="leading" />
      Get free quote
    </Button>
    <Button href="#process" variant="secondary" slot="actions">
      How it works
      <Icon name="arrow-right" size={18} strokeWidth={2.2} slot="trailing" />
    </Button>
    <AuditReportCard
      slot="visual"
      score={auditCard.score}
      domain={auditCard.domain}
      issueCount={auditCard.issueCount}
      issues={[...auditCard.issues]}
      footnote={auditCard.footnote}
    />
  </Hero>

  <StatPanel ariaLabel={stats.ariaLabel} stats={stats.items} />

  <section class="services" id="services" aria-labelledby="services-h">
    <div class="ds-container">
      <SectionHeader eyebrow={services.eyebrow} heading={services.heading} id="services-h" deck={services.deck} layout="split" />
      <div class="services-grid">
        {services.cards.map((card) => (
          <ServiceCard
            href={card.href}
            icon={card.icon}
            title={card.title}
            body={card.body}
            cta={card.cta}
            badge={card.badge}
          />
        ))}
      </div>
    </div>
  </section>

  <WhyCoverage id="why" eyebrow={why.eyebrow} heading={why.heading} body={why.body} checklist={why.checklist}>
    <CoverageCard slot="panel" label={coverage.label} meters={coverage.meters} source={coverage.source} />
  </WhyCoverage>

  <ProcessSteps id="process" heading={process.heading} steps={process.steps} />

  <Faq id="faq" heading={faq.heading} faqs={faq.items}>
    <p class="faq-cta" slot="deck">
      Still have questions?
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a> for a same-day reply.
    </p>
  </Faq>

  <CtaPanel id="quote" heading={cta.heading} deck={cta.deck}>
    <Button href={WA_LINK} variant="on-dark-solid" target="_blank" rel="noopener noreferrer" slot="actions">
      <Icon name="whatsapp" size={18} slot="leading" />
      Get free quote on WhatsApp
    </Button>
    <Button href="/free-ada-website-scan" variant="on-dark-outline" slot="actions">
      Run a free scan
    </Button>
  </CtaPanel>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* Services section shell — mockup rhythm: 96px top, 20px bottom */
  .services {
    padding: var(--section-y) var(--gutter) 20px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }
  @media (max-width: 1024px) {
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  /* Inline links inside body copy stay underlined (SC 1.4.1) */
  .faq-cta a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
